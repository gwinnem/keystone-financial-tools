    "@angular/platform-browser": "^22.2.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zone.js": "^0.16.3"
  }
