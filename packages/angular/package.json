{
  "name": "keystone-financial-tools-angular",
  "version": "0.1.0",
  "description": "Angular services for Keystone financial drawing tools",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": ">=22.0.0",
    "@angular/core": ">=22.0.0",
    "rxjs": "^7.5.0"
  },
  "dependencies": {
    "keystone-financial-tools-core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
