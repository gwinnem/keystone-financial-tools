{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "fileLogLevel": "info",
  "fileLogLevel_comment": "Writes stryker.log next to this file, so a failed run can be diagnosed from disk.",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "clearTextReporter": {
    "allowColor": true,
    "allowEmojis": true,
    "logTests": false,
    "reportScoreTable": true,
    "skipFull": false
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 8,
  "timeoutMS": 2500,
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "ignoreStatic": false,
  "mutate": ["src/**/*.ts", "!src/**/index.ts"],
  "mutate_comment": "Barrels (index.ts) are pure re-exports with no logic to mutate. The sibling keystone-financial-tools-core is not mutated: only this package's own src is.",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "thresholds_comment": "Any survivor fails the run: the floor is 100% (timed-out mutants count as detected). Never lower `break`.",
  "ignorePatterns": ["node_modules", "dist", "coverage", ".stryker-tmp", "reports"]
}
