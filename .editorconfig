# EditorConfig: https://editorconfig.org
# Kept in line with .prettierrc (2 spaces, 100 columns, LF) so editors and Prettier agree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yml,yaml}]
max_line_length = off

[*.{cmd,bat}]
end_of_line = crlf

[{package-lock.json,pnpm-lock.yaml}]
indent_size = unset
